<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_fragment"
    tools:context=".features.splash.SplashActivity">

    <!-- Animação de fundo -->
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottieBackgroundSplash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:alpha="0.2"
        android:scaleType="centerCrop"
        android:translationZ="-1dp"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/confetti_animation" />

    <!-- Conteúdo centralizado com título, animação e mensagem -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Nome do aplicativo -->
        <TextView
            android:id="@+id/appName"
            style="@style/BoldTitleText"
            android:text="@string/app_name" />

        <!-- Animação de carregamento -->
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieLoadingSplash"
            android:layout_width="200dp"
            android:layout_height="200dp"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/loading_splash_animation" />

        <!-- Mensagem exibida durante a espera -->
        <TextView
            android:id="@+id/loadingMessage"
            style="@style/CenteredMessageText"
            tools:text="Espere só um pouquinho... a diversão já vai começar!" />
    </LinearLayout>
</FrameLayout>

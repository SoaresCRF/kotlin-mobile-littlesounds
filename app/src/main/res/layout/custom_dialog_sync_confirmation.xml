<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_bg"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Título do diálogo -->
    <TextView
        android:id="@+id/textDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="12dp"
        android:text="@string/dialog_sync_title"
        android:textAlignment="center"
        android:textAllCaps="true"
        android:textColor="@color/dark_gray"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Linha separadora entre título e conteúdo -->
    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:dividerColor="@color/light_gray"
        app:dividerThickness="1dp" />

    <!-- Mensagem do diálogo -->
    <TextView
        android:id="@+id/textDialogMessage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="16dp"
        android:text="@string/dialog_sync_message"
        android:textAlignment="viewStart"
        android:textColor="@color/dark_gray"
        android:textSize="18sp" />

    <!-- Ícone de confirmação -->
    <ImageView
        android:id="@+id/imageDialogConfirmation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="16dp"
        android:contentDescription="@string/accessibility_dialog_sync_ic_confirmation"
        app:srcCompat="@drawable/ic_confirmation" />

</LinearLayout>
